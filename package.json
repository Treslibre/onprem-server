{
  "name": "threema-onprem-node-server",
  "version": "1.0.0",
  "description": "Protocol-compatible Node.js + TypeScript + Prisma backend for Threema OnPrem clients",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:sqlite": "tsx src/cli/migrateSqliteToPg.ts",
    "keys:init": "tsx src/cli/initKeys.ts",
    "tls:init": "tsx src/cli/initTls.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "protobufjs": "^7.4.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "prisma": "^6.19.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
